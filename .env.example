# Copy to `.env` and adjust. Every value is optional — sensible defaults live in
# src/zephyrus/config.py. No API keys are needed for the price/carbon endpoints.

ZEPHYRUS_GSP_GROUP=C            # GSP region letter A-P (C = London)
ZEPHYRUS_CARBON_REGION_ID=13   # blank = national; 13 = London
ZEPHYRUS_CARBON_WEIGHT_GBP_PER_KG=0.0  # value carbon in the objective (0 = pure cost)
ZEPHYRUS_HTTP_TIMEOUT_S=20
ZEPHYRUS_LOG_LEVEL=INFO
ZEPHYRUS_MLFLOW_TRACKING_URI=file:./mlruns
